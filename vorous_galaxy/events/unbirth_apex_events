namespace = unbirther

# Consumption event for unbirth
planet_event = {
	id = unbirther.1
	hide_window = yes
	is_triggered_only = yes
	allow = {
			OR = {has_global_flag = vag_vore_enabled}
			}
	trigger = {
		OR = {
			has_building = building_unbirth_chamber_of_rebirth
			has_building = building_unbirth_temple_of_motherhood
		}
		exists = owner
		owner = {
			has_origin = civic_unbirth_absorption
		}
		num_assigned_jobs = {
			job = unbirth_apprentice
			value >= 1
		}
	}

	immediate = {
		set_timed_planet_flag = {
			flag = unbirth_alert_timer
			days = 2880
		}
		random_owned_pop = {
			limit = {
				is_same_species = owner_species
				has_trait = trait_vore_lethal
			}
			species = { save_event_target_as = unbirth_pop_species }
		}
		every_owned_pop = {
			limit = { has_job = unbirth_apprentice }
			root = {
				change_variable = {
					which = var_unbirthed_pops
					value = 1
				}
				if = {
					limit = {
						exists = event_target:unbirth_pop_species
					}
					create_pop = {
						species = event_target:unbirth_pop_species
					}
				}
				else = {
					create_pop = {
						species = owner_species
					}
				}
				if = {
					limit = {
						last_created_pop = {
							NOT = { ideal_planet_class = root }
						}
						NOR = {
							uses_district_set = habitat
							uses_district_set = ring_world
							uses_district_set = city_world
							uses_district_set = hive_world
							uses_district_set = machine_world
							is_planet_class = pc_gaia
							is_planet_class = pc_relic
						}
						owner = {
							has_technology = tech_glandular_acclimation
							NOT = { ideal_planet_class = root }
						}
					}
					last_created_pop = {
						modify_species = {
							ideal_planet_class = root
						}
					}
				}
			}
			every_country = {
				limit = {
					has_communications = root.owner
					NOT = { is_country = root.owner }
					NOT = { is_same_species = prev }
					NOT = { has_ai_personality_behaviour = purger }
					NOT = { has_origin = civic_unbirth_absorption }
					NOT = { has_ethic = ethic_gestalt_consciousness }
					NOR = {
						has_valid_civic = civic_death_cult
						has_valid_civic = civic_death_cult_corporate
					}
					OR = {
						is_country_type = default
						has_ai_personality = awakened_fallen_empire_xenophile
					}
				}
				add_opinion_modifier = { who = root.owner modifier = opinion_necrophage }
			}
			every_country = {
				limit = {
					has_communications = root.owner
					NOT = { is_country = root.owner }
					is_same_species = prev
				}
				add_opinion_modifier = { who = root.owner modifier = Opinion_unbirth_our_species }
			}
			kill_pop = yes
		}
		create_message = {
			type = MESSAGE_NECROPHAGE_POPS_NECROPHAGED
			localization = MESSAGE_UNBIRTH_POPS_UNBIRTHED
			days = 30
			target = this
			variable = {
				type = name
				localization = PLANET
				scope = this
			}
			variable = {
				type = variable
				varname = var_unbirthed_pops
				localization = VALUE
				scope = this
			}
		}
		if = {
			limit = {
				owner = {
					has_swapped_tradition = tr_harmony_unity_of_self
				}
			}
			owner = {
				add_monthly_resource_mult = {
					resource = unity
					value = 1.5
					min = 5
					max = 100
				}
			}
		}
		set_variable = {
			which = var_unbirthed_pops
			value = 0
		}
	}
}


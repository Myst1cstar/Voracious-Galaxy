namespace = vore

country_event = {
	id = vore.1
	hide_window = yes
	is_triggered_only = yes

	trigger = {
		any_owned_planet = {
			NOT = {
				has_planet_flag = recent_vore_frenzy
			}

			count_species = {
				count > 1
			}

			any_owned_species = {
				species = {
					NOT = {
						has_trait = trait_vore_lethal
					}
				}
			}
			
			any_owned_species = {
				species = {
					has_trait = trait_vore_lethal
				}
			}
		}
	}

	immediate = {
		random_owned_planet = {
			limit = {
				NOT = {
					has_planet_flag = recent_vore_frenzy
				}
			}
			
			if = {
				limit = { 
					count_species = {
						count > 1
					}
	
					any_owned_species = {
						species = {
							NOT = {
								has_trait = trait_vore_lethal
							}
						}
					}
					
					any_owned_species = {
						species = {
							has_trait = trait_vore_lethal
						}
					}
				}
				random = {
					chance = 60
					random_owned_species = {
						limit = {
							species = {
								has_trait = trait_vore_lethal
							}
						}
						species = { save_global_event_target_as = vore_species }
					}
					random_owned_species = {
						limit = {
							species = {
								NOT = {
									has_trait = trait_vore_lethal
								}
							}
						}
						species = { save_global_event_target_as = prey_species }
					}
					planet_event = {
						id = vore.2
						days = 10
						random = 30
					}
			}
			}
		}
	}
}

planet_event = {
	id = vore.2
	hide_window = no
	is_triggered_only = yes
	title = vore.2.title
	desc = vore.2.desc
	picture = GFX_evt_burning_settlement
	show_sound = event_air_raid_siren

	pre_triggers = {
		has_ground_combat = no
		is_occupied_flag = no
	}

	immediate = {
			add_planet_devastation = 5

			add_modifier = {
				modifier = vore_frenzy
				years = 5
			}

			set_timed_planet_flag = {
				flag = recent_vore_frenzy
				years = 10
			}

			random_owned_pop = {
				limit = {
					NOT = {
						has_trait = trait_vore_lethal
					}
				}

				kill_pop = yes
			}
	}

	option = {
		name = SPLENDID

		trigger = {
			owner_species = {
				has_trait = trait_vore_lethal
			}
		}
	}

	option = {
		name = WORRYING

		trigger = {
			always = yes
		}
	}

	option = {
		name = vore.2.c

		trigger = {
			owner_species = {
				NOT = {
					has_trait = trait_vore_lethal
				}
			}
			owner = {
				OR = {
					has_ethic = ethic_xenophobe
					has_ethic = ethic_fanatic_xenophobe
				}
			}
		}

		random_owned_pop = {
			limit = {
				is_same_species = event_target:vore_species
			}

			kill_pop = yes
		}

		random_owned_pop = {
			limit = {
				is_same_species = event_target:vore_species
			}

			kill_pop = yes
		}

		add_planet_devastation = 10

		add_modifier = {
			modifier = vore_frenzy_put_down
			years = 2
		}

		remove_modifier = vore_frenzy
	}

	option = {
		name = vore.2.d

		trigger = {
			owner_species = {
				has_trait = trait_vore_prey
			}
		}

		owner = {
			kill_leader = {
				type = ruler
				show_notification = yes
				heir = no
			}
		}
	}

	after = {
		clear_global_event_target = vore_species
		clear_global_event_target = prey_species
	}
}


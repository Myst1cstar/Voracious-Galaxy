decision_planet_pred_promotion = {
	owned_planets_only = yes

	resources = {
		category = decisions
		cost = {
			influence = 50
		}
	}

	potential = {
		owner = { is_regular_empire = yes }
			this = { any_owned_pop = {
				has_trait = trait_vore_lethal
			} }
	}

	allow = {
		NOT = {
			has_planet_flag = recent_pred_promotion
		}
	}

	effect = {
		set_timed_planet_flag = {
			flag = recent_pred_promotion
			years = 10
		}
		every_owned_pop = {
			limit = {
				has_trait = trait_vore_lethal
			}
			add_modifier = {
				modifier = pred_promotion_pred
				years = 10
			}
		}
		every_owned_pop = {
			limit = {
				NOT = {
					has_trait = trait_vore_lethal
				}
			}
			add_modifier = {
				modifier = pred_promotion_prey
				years = 10
			}
		}
	}
}

building_unbirth_chamber_of_rebirth = {
	icon = building_chamber_of_elevation_1
	base_buildtime = @b1_time
	base_cap_amount = 1
	add_to_first_building_slot = yes

	category = pop_assembly

building_sets = {
		unity
	}

	potential = {
		exists = owner
		owner = {
			has_origin = civic_unbirth_absorption
			NOT = { has_valid_civic = civic_fanatic_purifiers }
		}
	}
	
	allow = {
		custom_tooltip = {
			fail_text = NO_CULTURE_SHOCK
			NOT = { has_modifier = planet_culture_shock }
		}
		NOR = {
			is_planet_class = pc_hive
			is_planet_class = pc_machine
		}
		OR = {
			owner = { is_ai = no }
			any_owned_species = {
				species_can_be_necrophaged = yes
			}
		}
	}

	destroy_trigger = {
		exists = owner
		OR = {
			owner = {
				OR = {
					NOT = { has_origin = civic_unbirth_absorption }

				}
			}
			AND = {
				owner = { is_ai = yes }
				NOT = {
					any_owned_species = {
						species_can_be_necrophaged = yes
					}
				}
			}
		}
	}
	
	planet_modifier = {
		planet_stability_add = 5
		job_unbirth_apprentice_add = 300
	}
	
	resources = {
		category = planet_buildings
		cost = {
			minerals = @b1_minerals
		}
		upkeep = {
			energy = @b1_upkeep
		}
	}
	
	upgrades = {
		building_unbirth_temple_of_motherhood
	}
	
	prerequisites = {
	}
	
	triggered_desc = {
		text = job_unbirth_apprentice_effect_desc
		trigger = {
			exists = owner
			owner = { is_lithoid_empire = no }
		}
	}
	triggered_desc = {
		text = job_unbirth_apprentice_effect_lithoid_desc
		trigger = {
			exists = owner
			owner = { is_lithoid_empire = yes }
		}
	}
	
	ai_weight = {
		weight = 50000
	}

	#this tells the AI that building the building will give it this in a way it doesn't understand. Made the number nice and high to try and force the AI to build this.
	ai_resource_production = {
		trigger = { always = yes }
		alloys = 8
		consumer_goods = 8
	}
}


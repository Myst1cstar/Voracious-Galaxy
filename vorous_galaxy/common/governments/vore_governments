# Apex Dictatorship
gov_apex_dictatorship = {
	ruler_title = RT_PATRIARCH
	ruler_title_female = RT_MATRIARCH
	
	should_force_rename = no
	
	leader_class = admiral 	# Initial ruler will become this if elected out of office

	election_candidates = {
		modifier = {
			add = 100
			leader_class = ruler
		}
		modifier = {
			add = 15
			OR = {
				leader_class = admiral
				leader_class = general
				
			}
		}

		modifier = {
			add = 1
			OR = {
				leader_class = scientist
				leader_class = governor
				
			}
		}
	}

	possible = {
		has_authority = auth_dictatorial
		has_valid_civic = civic_vore_darwinism
	}

	weight = {
		base = 800
		modifier = {
			factor = 2
			has_civic = civic_vore_darwinism
		}
	}
}

